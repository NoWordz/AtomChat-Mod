{
  "schemaVersion": 1,
  "id": "atomchat",
  "version": "${version}",
  "name": "AtomChat",
  "description": "A phone-app style chat experience for Minecraft, powered by Skia.",
  "authors": [
    "E33EPUS"
  ],
  "license": "MIT",
  "environment": "*",
  "icon": "assets/atomchat/logo.png",
  "contact": {
    "homepage": "https://github.com/NoWordz/AtomChat-Mod",
    "issues": "https://github.com/NoWordz/AtomChat-Mod/issues",
    "sources": "https://github.com/NoWordz/AtomChat-Mod"
  },
  "entrypoints": {
    "main": [
      "com.atom.chat.AtomChat"
    ],
    "client": [
      "com.atom.chat.AtomChatClient"
    ]
  },
  "mixins": [
    {
      "config": "atomchat.screen.mixins.json",
      "environment": "client"
    },
    {
      "config": "atomchat.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "atomchat.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}