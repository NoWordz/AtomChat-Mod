{
  "schemaVersion": 1,
  "id": "atomchat",
  "version": "${version}",
  "name": "AtomChat",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "MIT",
  "environment": "*",
  "icon": "assets/atomchat/mod_logo.png",
  "contact": {
    "homepage": "${mod_repository_url}",
    "issues": "${mod_issues_url}",
    "sources": "${mod_repository_url}"
  },
  "entrypoints": {
    "main": [
      "com.atom.chat.AtomChat"
    ],
    "client": [
      "com.atom.chat.AtomChatClient"
    ]
  },
  "mixins": [
    {
      "config": "atomchat.screen.mixins.json",
      "environment": "client"
    },
    {
      "config": "atomchat.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "atomchat.reactions.mixins.json"
    }
  ],
  "accessWidener": "atomchat.accesswidener",
  "suggests": {
    "atomlib": "${atomlib_fabric_range}"
  },
  "custom": {
    "atomlib:client-required": "${atomlib_fabric_range}"
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
